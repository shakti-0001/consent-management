# ============================================================
# Database — PostgreSQL
# ============================================================
DATABASE_URL=postgresql+psycopg://postgres:cntx%40123@localhost:5432/consent_management

# ============================================================
# Internal service authentication
# Generate a new random secret; do not reuse the signing key.
# ============================================================
CONSENT_INTERNAL_KEY=qJuZ0e7DH81S9KJvzhilVmBBAJ8iwE67L_UDKwi4I3gmn9d-y2gUX7COtyWZBGUO

# ============================================================
# Trusted WSO2 identity verification
# Keep enabled when using the real Gateway integration.
# ============================================================
REQUIRE_TRUSTED_WSO2_HEADERS=true
GATEWAY_IDENTITY_SIGNING_KEY=oNVCm3c_buhpxt53Qq0rAYPfrgQD5ejHw5Hpu805H8Apux4IeB7vLckdhmbdTHjB

# ============================================================
# WSO2 OAuth2 — service credentials for metadata access
# Use the rotated secret for the consent service's OAuth client.
# ============================================================
WSO2_TOKEN_URL=https://localhost:9443/oauth2/token
WSO2_CLIENT_ID=bALK8iNRK2UiKWRof_vqNs7lsoUa
WSO2_CLIENT_SECRET=lr6HnLSvPSxHbmYGC25PsguGhaUa
WSO2_CLIENT_SCOPE=apim:api_view apim:api_definition_view

# ============================================================
# WSO2 Publisher API — metadata integration
# ============================================================
WSO2_API_METADATA_BASE=https://localhost:9443/api/am/publisher/v4
WSO2_TLS_VERIFY=false
WSO2_CA_BUNDLE=

# ============================================================
# FastAPI server
# ============================================================
HOST=127.0.0.1
PORT=8100

# ============================================================
# Local testing identity
# Disabled for real Gateway-based authentication.
# ============================================================
ALLOW_STATIC_TEST_IDENTITY=false
STATIC_TEST_USER=consent-test-user
STATIC_TEST_APPLICATION_ID=YOUR_WSO2_APPLICATION_ID

# ============================================================
# Publisher and administrator roles
# Confirm these names match your actual WSO2 role mappings.
# ============================================================
PUBLISHER_ROLES=consent-publisher,Internal/publisher
ADMIN_ROLES=consent-admin,admin,Internal/admin
WSO2_SYNC_INTERVAL_SECONDS=60
DEFAULT_ALLOWED_PURPOSES=business,student-verification
DEFAULT_MAX_DURATION_DAYS=30
ALLOWED_UPSTREAM_HOSTS=localhost,127.0.0.1
WSO2_TARGET_API_ID=e3b7df1a-3531-46dd-aca9-6eda2746c36a
WSO2_TARGET_API_NAME=NewStudentsApi
ALLOW_OPENAPI_FIELD_FALLBACK=false